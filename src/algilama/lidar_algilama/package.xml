<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <!-- Paketin adı: colcon ve ros2 komutlarında bu isimle çağrılır -->
  <name>lidar_algilama</name>
  <version>0.1.0</version>
  <description>RoboSense Helios 32 nokta bulutundan sektör tabanlı engel algılama (DUR / DIKKAT / GUVENLI) ve nesne algılama (LiDAR odometri, hareketli nesne + yol koridoru, kutu, mesafe, etiket, takip)</description>
  <maintainer email="ayberk@todo.todo">ayberk</maintainer>
  <license>Apache-2.0</license>

  <!-- Derleme sistemi: C++ paketleri için ament_cmake -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Kodun kullandığı ROS 2 paketleri (hem derlemede hem çalışırken gerekli) -->
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>rcl_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>

  <!-- nesne_node için: nokta bulutu işleme (PCL) ve ortak mesajlar -->
  <depend>libpcl-all-dev</depend>
  <depend>pcl_conversions</depend>
  <depend>robotaksi_msgs</depend>

  <!-- Sadece çalışma anında gerekli: launch dosyası için -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
