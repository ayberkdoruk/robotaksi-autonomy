<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>kontrol_merkezi</name>
  <version>0.1.0</version>
  <description>Robotaksi Kontrol Merkezi: LiDAR sürücüsü, engel algılama, kayıt alma ve oynatma tek pencerede; Türkçe ayar paneli ve kayıt/oynat betikleri</description>
  <maintainer email="ayberkdoruk.dev@gmail.com">Ayberk Doruk</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Ortak ortam (ros_ortami.sh) ve yönetilen algılama düğümleri -->
  <exec_depend>robotaksi_baslat</exec_depend>
  <exec_depend>robotaksi_msgs</exec_depend>
  <exec_depend>lidar_algilama</exec_depend>

  <!-- Arayüz (Python + Qt) -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>python_qt_binding</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <!-- Kayıt alma / oynatma (ros2 bag, MCAP) ve oynatıcı denetimi (duraklat, hız, atla) -->
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>rosbag2_storage_mcap</exec_depend>
  <exec_depend>rosbag2_interfaces</exec_depend>

  <!-- lidar_sistem.launch.py ve LiDAR'ı İzle için: sürücü ve RViz -->
  <exec_depend>rslidar_sdk</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
